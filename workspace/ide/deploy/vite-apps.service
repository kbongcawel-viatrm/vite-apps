[Unit]
Description=vite-apps: manager UI + hardened edge proxy + code-server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/workspace/vite-apps
# nvm is initialized lazily in .bashrc (unavailable to systemd), so pin the
# node binary directly. Update this path after a node version upgrade:
#   ls ~/.nvm/versions/node/
Environment=PATH=%h/.nvm/versions/node/v26.13.1/bin:/usr/local/bin:/usr/bin
ExecStart=%h/.nvm/versions/node/v26.13.1/bin/node workspace/ide/server/standalone.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=default.target
