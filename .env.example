# Port for the Vite management UI (dev server / preview)
VITE_PORT=5173

# Port + bind address for the hardened edge proxy that fronts code-server.
# Default binds to localhost only. To expose remotely, terminate TLS in front
# of it (see workspace/ide/deploy/Caddyfile) and keep EDGE_BIND=127.0.0.1.
EDGE_PORT=8080
EDGE_BIND=127.0.0.1

# Internal port code-server itself listens on (localhost only, never exposed).
CODE_SERVER_PORT=18080

# REQUIRED: password for code-server login. Generate one, e.g.:
#   openssl rand -base64 24
PASSWORD=

# Directory code-server opens as the workspace
CODE_SERVER_WORKSPACE=./workspace

# Public URL shown in the UI for the editor (behind your TLS proxy if used)
PUBLIC_EDITOR_URL=http://localhost:8080

# Optional: token for the GitHub read-only MCP server in code-server's
# user-level mcp.json (${env:GITHUB_READ_ONLY_TOKEN} is interpolated by VS Code)
GITHUB_READ_ONLY_TOKEN=

# Cloudflare Tunnel token (Zero Trust dashboard -> Networks -> Tunnels).
# Required only for the compose.yaml cloudflared service.
TUNNEL_TOKEN=
