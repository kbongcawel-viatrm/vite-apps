{
  "name": "vite-apps",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "workspace/mgmt-dashboard"
  ],
  "scripts": {
    "dev": "npm run dev --workspace workspace/mgmt-dashboard",
    "build": "npm run build --workspace workspace/mgmt-dashboard",
    "preview": "npm run preview --workspace workspace/mgmt-dashboard",
    "server": "node workspace/ide/server/standalone.mjs",
    "install:code-server": "bash workspace/ide/scripts/install-code-server.sh",
    "deploy": "bash workspace/ide/scripts/deploy.sh",
    "file-manager": "podman-compose -f workspace/file-manager/compose.yaml"
  },
  "dependencies": {
    "http-proxy": "^1.18.1"
  }
}
